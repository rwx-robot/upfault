{
  "name": "@upfault/runtime",
  "version": "0.2.0",
  "description": "UpFault 运行时核心",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./h": {
      "types": "./dist/h.d.ts",
      "import": "./dist/h.mjs",
      "require": "./dist/h.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle.d.ts",
      "import": "./dist/lifecycle.mjs",
      "require": "./dist/lifecycle.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.mjs",
      "require": "./dist/renderer.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm run build:esm",
    "build:esm": "esbuild src/index.ts --bundle --format=esm --outfile=dist/index.mjs --external:@upfault/* --platform=node",
    "dev": "tsc -w -p tsconfig.build.json",
