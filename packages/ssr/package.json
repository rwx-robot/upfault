{
  "name": "@upfault/ssr",
  "version": "0.2.0",
  "description": "UpFault 服务端渲染",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.mjs",
      "require": "./dist/render.js"
    },
    "./streaming": {
      "types": "./dist/streaming.d.ts",
      "import": "./dist/streaming.mjs",
      "require": "./dist/streaming.js"
    },
    "./hydration": {
      "types": "./dist/hydration.d.ts",
      "import": "./dist/hydration.mjs",
      "require": "./dist/hydration.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.mjs",
      "require": "./dist/middleware.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.mjs",
      "require": "./dist/components.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm run build:esm && pnpm run build:cjs",
    "build:esm": "esbuild src/index.ts --bundle --format=esm --outfile=dist/index.mjs --external:@upfault/* --platform=node",
    "dev": "tsc -w -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "build:cjs": "esbuild src/index.ts --bundle --format=cjs --outfile=dist/index.js --external:@upfault/* --platform=node"
  },
  "dependencies": {
    "@upfault/runtime": "workspace:*",
    "@upfault/reactivity": "workspace:*",
    "@upfault/shared": "workspace:*",
    "@upfault/diff": "workspace:*",
    "@upfault/scheduler": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.4.0",
    "esbuild": "^0.20.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
