{
  "name": "@upfault/vite-plugin",
  "version": "0.2.0",
  "description": "UpFault Vite 插件 —— 编译 .uf 单文件组件",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm run build:esm && pnpm run build:cjs",
    "build:esm": "esbuild src/index.ts --bundle --format=esm --outfile=dist/index.mjs --external:@upfault/* --external:vite --platform=node",
    "dev": "tsc -w -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "build:cjs": "esbuild src/index.ts --bundle --format=cjs --outfile=dist/index.js --external:@upfault/* --external:vite --platform=node"
  },
  "dependencies": {
    "@upfault/compiler": "workspace:*"
  },
  "peerDependencies": {
    "vite": ">=4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^1.4.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
