{
  "name": "@upfault/shared",
  "version": "0.2.0",
  "description": "UpFault Shared Types, Constants & Utilities",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./flags": {
      "types": "./dist/flags.d.ts",
      "import": "./dist/flags.mjs",
      "require": "./dist/flags.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler.d.ts",
      "import": "./dist/scheduler.mjs",
      "require": "./dist/scheduler.js"
    },
    "./reactivity": {
      "types": "./dist/reactivity.d.ts",
      "import": "./dist/reactivity.mjs",
      "require": "./dist/reactivity.js"
    },
    "./diff": {
      "types": "./dist/diff.d.ts",
      "import": "./dist/diff.mjs",
      "require": "./dist/diff.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm run build:esm",
    "build:esm": "esbuild src/index.ts --bundle --format=esm --outfile=dist/index.mjs --platform=neutral",
    "dev": "tsc -w -p tsconfig.build.json",
