{
  "name": "@upfault/cli",
  "version": "0.2.0",
  "description": "UpFault CLI 脚手架工具",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm run build:esm",
    "build:esm": "esbuild src/index.ts --bundle --format=esm --outfile=dist/index.mjs --external:@upfault/* --external:open --external:fsevents --platform=node",
    "dev": "tsc -w -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@upfault/runtime": "workspace:*",
    "@upfault/shared": "workspace:*",
    "@upfault/compiler": "workspace:*",
    "chokidar": "^3.6.0",
    "esbuild": "^0.20.0",
    "picocolors": "^1.0.0",
    "prompts": "^2.4.2"
  },