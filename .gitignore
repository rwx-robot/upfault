# tsc 产物不得混入 src/（vite 解析 .js 优先于 .ts，会让测试加载旧产物 —— 2026-09-21 评审教训）
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map

# CLI 临时输出（dev/preview/init 命令产生）
.upfault-dev/
.upfault-preview/
# 单元测试副作用（init 命令在测试 cwd 下创建的项目）
/a
/b
/existing
/my-app
/proj
